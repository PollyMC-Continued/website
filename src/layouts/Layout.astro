---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import backgroundImg from '../assets/background.webp';

interface Props {
	title: string;
	description: string;
	canonical?: string;
	background?: ImageMetadata;
	active?: string;
	noindex?: boolean;
}

const {
	title,
	description,
	canonical,
	background = backgroundImg,
	active,
	noindex = false,
} = Astro.props;

const fullTitle = `${title} - PollyMC-Continued`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#333333" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		{!noindex && canonical && (
			<>
				<link rel="canonical" href={canonical} />
				<meta property="og:type" content="website" />
				<meta property="og:site_name" content="PollyMC-Continued" />
				<meta property="og:title" content={fullTitle} />
				<meta property="og:description" content={description} />
				<meta property="og:image" content="https://pollymc.vercel.app/background.png" />
				<meta property="og:url" content={canonical} />
				<meta name="twitter:card" content="summary_large_image" />
				<meta name="twitter:title" content={fullTitle} />
				<meta name="twitter:description" content={description} />
				<meta name="twitter:image" content="https://pollymc.vercel.app/background.png" />
			</>
		)}
		{noindex && <meta name="robots" content="noindex" />}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Image
			class="background"
			src={background}
			alt=""
			aria-hidden="true"
			role="presentation"
		/>
		<Navbar active={active} />
		<slot />
		<Footer />
	</body>
</html>
