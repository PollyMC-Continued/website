---
import { Image } from 'astro:assets';
import { links, platforms } from '../lib/site';
---

<ul class="download-tabs" role="tablist">
	{platforms.map((platform, i) => (
		<li role="presentation">
			<a
				href={`#${platform.id}`}
				role="tab"
				id={`tab-${platform.id}`}
				aria-selected={i === 0 ? 'true' : 'false'}
				aria-controls={`panel-${platform.id}`}
			>
				{platform.name}
			</a>
		</li>
	))}
</ul>

{platforms.map((platform, i) => (
	<div
		class={`download-panel${i === 0 ? '' : ' hidden'}`}
		id={`panel-${platform.id}`}
		role="tabpanel"
		aria-labelledby={`tab-${platform.id}`}
	>
		<div class="panel-body">
			<div class="download-screenshot">
				<span class="shot-ph">Screenshot coming soon</span>
				{platform.screenshot && (
					<>
						<Image
							class="shot-bg"
							src={platform.screenshot}
							alt=""
							aria-hidden="true"
							loading="lazy"
							decoding="async"
							onerror="this.remove()"
						/>
						<Image
							class="shot-fg"
							src={platform.screenshot}
							alt={`PollyMC-Continued on ${platform.name}`}
							loading="lazy"
							decoding="async"
							onload="this.closest('.download-screenshot').classList.add('has-shot')"
							onerror="this.remove()"
						/>
					</>
				)}
			</div>
			<div class="panel-links">
				<h2 class="dl-title">{platform.title}</h2>
				<p class="dl-version">
					Download PollyMC-Continued <span class="ver">latest</span>
				</p>
				{platform.assets.map((asset) => {
					return (
						<a
							class={`button dl-button${asset.secondary ? ' secondary' : ''}`}
							href={links.releases}
							data-match={asset.match}
							target="_blank"
							rel="noopener"
						>
							{asset.label}
						</a>
					);
				})}
				{platform.note && <small class="dl-note">{platform.note}</small>}
			</div>
		</div>
	</div>
))}
