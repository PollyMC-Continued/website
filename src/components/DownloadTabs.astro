---
import { Image } from 'astro:assets';
import { links, platforms } from '../lib/site';
import windowsIcon from '../icons/windows.svg?raw';
import macosIcon from '../icons/macos.svg?raw';
import linuxIcon from '../icons/linux.svg?raw';
import downloadIcon from '../icons/download.svg?raw';

const icons: Record<string, string> = {
	windows: windowsIcon,
	macos: macosIcon,
	linux: linuxIcon,
};
---

<div class="download-tabs-wrap">
	<ul class="download-tabs" role="tablist">
		{platforms.map((platform, i) => (
			<li role="presentation" class={i === 0 ? 'download-tab-active' : ''}>
				<a
					href={`#${platform.id}`}
					role="tab"
					id={`tab-${platform.id}`}
					aria-selected={i === 0 ? 'true' : 'false'}
					aria-controls={`panel-${platform.id}`}
				>
					<span class="tab-icon" set:html={icons[platform.id]} />
					<span class="tab-label">{platform.name}</span>
				</a>
			</li>
		))}
	</ul>
</div>

{platforms.map((platform, i) => (
	<div
		class={`download-panel${i === 0 ? '' : ' hidden'}`}
		id={`panel-${platform.id}`}
		role="tabpanel"
		aria-labelledby={`tab-${platform.id}`}
	>
		<div class="panel-body">
			<div class="download-screenshot">
				<span class="shot-ph">Screenshot coming soon</span>
				{platform.screenshot && (
					<>
						<Image
							class="shot-bg"
							src={platform.screenshot}
							alt=""
							aria-hidden="true"
							loading="lazy"
							decoding="async"
							onerror="this.remove()"
						/>
						<Image
							class="shot-fg"
							src={platform.screenshot}
							alt={`PollyMC-Continued on ${platform.name}`}
							loading="lazy"
							decoding="async"
							onload="this.closest('.download-screenshot').classList.add('has-shot')"
							onerror="this.remove()"
						/>
					</>
				)}
			</div>
			<div class="panel-links">
				<h2 class="dl-title">{platform.title}</h2>
				<p class="dl-version">
					Download PollyMC-Continued <span class="ver">latest</span>
				</p>
				{platform.assets.map((asset) => {
					return (
						<a
							class={`button dl-button${asset.secondary ? ' secondary' : ''}`}
							href={links.releases}
							data-match={asset.match}
						>
							<span class="dl-button-icon" set:html={icons[platform.id]} />
							<span class="dl-button-label">{asset.label}</span>
							<span class="dl-button-download" set:html={downloadIcon} />
						</a>
					);
				})}
				{platform.note && <small class="dl-note">{platform.note}</small>}
			</div>
		</div>
	</div>
))}