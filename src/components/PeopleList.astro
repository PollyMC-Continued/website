---
interface Person {
	name: string;
	href: string;
	avatar: string;
	role?: string;
}

interface Props {
	people: Person[];
}

const { people } = Astro.props;
---

<ul class="people people-lg">
	{people.map((p) => (
		<li>
			<a href={p.href} target="_blank" rel="noopener" aria-label={p.name} title={p.name}>
				<img src={p.avatar} alt={p.name} width="160" height="160" loading="lazy" />
			</a>
		</li>
	))}
</ul>
