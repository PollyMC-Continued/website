---
import type { ChangelogBlock } from '../lib/changelog';

interface Props {
	blocks: ChangelogBlock[];
}

const { blocks } = Astro.props;
---

{
	blocks.map((block) => {
		if (block.type === 'version') {
			return (
				<h2><a href={block.url} target="_blank" rel="noopener">{block.version}</a></h2>
			);
		}
		if (block.type === 'label') {
			return (
				<h3 class={block.cls ? `tag ${block.cls}` : undefined}>{block.text}</h3>
			);
		}
		if (block.type === 'list') {
			return (
				<ul>
					{block.items.map((item) => (
						<li class={item.cls ? `tag ${item.cls}` : undefined} set:html={item.html} />
					))}
				</ul>
			);
		}
		return <p set:html={block.html} />;
	})
}
