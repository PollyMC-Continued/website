---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    src: ImageMetadata;
    alt: string;
    assetHint: string;
    reveal?: boolean;
}

const { src, alt, assetHint, reveal = true } = Astro.props;
---

<div class={`shot${reveal ? " reveal" : ""}`}>
    <span class="shot-ph"
        >Screenshot coming soon — add <code>{assetHint}</code></span
    >
    <Image
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        onerror="this.remove()"
    />
</div>
