---
import Layout from '../../../layouts/Layout.astro';
import { site } from '../../../lib/site';
---

<Layout
	title="Restricted"
	description="Restricted review console."
	canonical={`${site.url}/translation/vault/`}
	noindex
>
	<main id="main" class="container">
		<!-- Unauthenticated Gate -->
		<section id="va-gate" class="content va-gate">
			<div class="va-lock-badge" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="4" y="11" width="16" height="10" rx="2" />
					<path d="M8 11V7a4 4 0 0 1 8 0v4" />
				</svg>
			</div>
			<h1 class="sec-h">Restricted Console</h1>
			<p class="va-muted">Enter the maintainer key to unlock the translation review queue.</p>
			<form id="va-login-form" class="va-login-form" novalidate>
				<p id="va-login-err" class="va-error" role="alert"></p>
				<label class="va-field">
					<span class="visually-hidden">Maintainer key</span>
					<div id="va-pw-wrap" class="va-pw-wrap">
						<input
							id="va-secret"
							type="password"
							autocomplete="current-password"
							placeholder="Maintainer key"
						/>
						<button type="button" id="va-toggle-pw" class="va-pw-toggle" aria-label="Show key">
							Show
						</button>
					</div>
				</label>
				<button type="submit" id="va-login-btn" class="button">Unlock</button>
			</form>
		</section>

		<!-- Authenticated Console -->
		<section id="va-app" class="content va-app hidden">
			<div class="va-head">
				<div>
					<h1 class="sec-h">Translation Submissions</h1>
					<p id="va-summary" class="va-muted">Loading queue…</p>
				</div>
				<div class="va-head-actions">
					<button type="button" id="va-refresh" class="button secondary">Refresh</button>
					<button type="button" id="va-logout" class="button secondary">Sign out</button>
				</div>
			</div>

			<div class="va-toolbar">
				<label class="va-search-wrap">
					<span class="visually-hidden">Search submissions</span>
					<input
						id="va-search"
						type="search"
						placeholder="Filter by contributor, contact, language, or ID…"
						autocomplete="off"
					/>
				</label>
				<div class="va-controls">
					<span id="va-lang-label" class="visually-hidden">Filter by language</span>
					<div id="va-lang-filter" class="va-select" data-label-id="va-lang-label"></div>
					<span id="va-sort-label" class="visually-hidden">Sort submissions</span>
					<div id="va-sort" class="va-select" data-label-id="va-sort-label"></div>
				</div>
			</div>

			<p id="va-banner" class="va-banner hidden" role="status"></p>

			<div class="va-workspace">
				<ul id="va-list" class="va-list" aria-live="polite"></ul>
				<div id="va-detail" class="va-detail">
					<div class="va-detail-empty">Select a submission to inspect its suggested strings.</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	import { languageName, RTL_LANGUAGES } from '../../../lib/languages';
	import { initCustomSelect, type CustomSelectController } from '../../../scripts/custom-select';

	interface QueueSummaryItem {
		id: string;
		lang: string;
		name: string;
		contact: string;
		received: string;
		strings: number;
	}

	interface SuggestionItem {
		index: number;
		base: string[];
		texts: string[];
	}

	interface FullSubmission extends QueueSummaryItem {
		suggestions: SuggestionItem[];
	}

	interface SourceEntry {
		context: string;
		source: string;
		comment: string;
	}

	const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;

	const API = '/api/translations-admin';
	let entries: QueueSummaryItem[] = [];
	let selectedId = '';
	let currentDetail: FullSubmission | null = null;
	let langFilter = 'all';
	let sortMode = 'fifo';
	let langFilterCtrl: CustomSelectController | null = null;
	const sourceCache = new Map<string, Map<number, SourceEntry>>();

	function escapeHtml(text: string): string {
		return text
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#39;');
	}

	function showBanner(msg: string, ok = false): void {
		const el = $('va-banner');
		if (!msg) {
			el.classList.add('hidden');
			el.textContent = '';
			return;
		}
		el.classList.remove('hidden');
		el.classList.toggle('is-ok', ok);
		el.textContent = msg;
	}

	function setUnlocked(unlocked: boolean): void {
		$('va-gate').classList.toggle('hidden', unlocked);
		$('va-app').classList.toggle('hidden', !unlocked);
	}

	async function loadSourceMap(lang: string): Promise<Map<number, SourceEntry>> {
		const cached = sourceCache.get(lang);
		if (cached) return cached;
		const map = new Map<number, SourceEntry>();
		try {
			const res = await fetch(`/translation/sources/${encodeURIComponent(lang)}.ts`);
			if (!res.ok) return map;
			const doc = new DOMParser().parseFromString(await res.text(), 'application/xml');
			let idx = 0;
			doc.querySelectorAll('context').forEach((ctx) => {
				const ctxName = ctx.querySelector('name')?.textContent ?? '';
				ctx.querySelectorAll(':scope > message').forEach((msg) => {
					if (!msg.querySelector(':scope > translation')) return;
					map.set(idx++, {
						context: ctxName,
						source: msg.querySelector(':scope > source')?.textContent ?? '',
						comment: msg.querySelector(':scope > comment')?.textContent ?? '',
					});
				});
			});
			sourceCache.set(lang, map);
		} catch {
			// fallback without source text
		}
		return map;
	}

	function updateLangFilterOptions(): void {
		const langs = [...new Set(entries.map((e) => e.lang))].sort((a, b) =>
			languageName(a).localeCompare(languageName(b))
		);
		const opts = [
			{ value: 'all', label: `All languages (${langs.length})` },
			...langs.map((l) => ({ value: l, label: `${languageName(l)} (${l})` })),
		];
		if (!langs.includes(langFilter)) langFilter = 'all';
		langFilterCtrl?.setOptions(opts, langFilter);
	}

	function renderList(): void {
		const list = $('va-list');
		list.textContent = '';
		const q = ($('va-search') as HTMLInputElement).value.trim().toLowerCase();

		const filtered = entries.filter((e) => {
			if (langFilter !== 'all' && e.lang !== langFilter) return false;
			if (q) {
				const hay = `${e.id} ${e.lang} ${languageName(e.lang)} ${e.name} ${e.contact}`.toLowerCase();
				if (!hay.includes(q)) return false;
			}
			return true;
		});

		filtered.sort((a, b) => {
			if (sortMode === 'newest') return b.received.localeCompare(a.received);
			if (sortMode === 'strings') return b.strings - a.strings;
			return a.received.localeCompare(b.received); // FIFO oldest first
		});

		const totalStrings = entries.reduce((acc, e) => acc + e.strings, 0);
		$('va-summary').textContent =
			entries.length === 0
				? 'Queue is empty.'
				: `${entries.length} pending submission(s) · ${totalStrings.toLocaleString()} string(s) total`;

		if (filtered.length === 0) {
			list.innerHTML = '<li class="va-empty">No submissions match the current filter.</li>';
			return;
		}

		for (const e of filtered) {
			const li = document.createElement('li');
			li.className = 'va-item' + (e.id === selectedId ? ' is-selected' : '');
			li.dataset.id = e.id;
			const dateStr = new Date(e.received).toLocaleString();
			li.innerHTML = `
				<button type="button" class="va-item-btn" data-id="${escapeHtml(e.id)}">
					<div class="va-item-top">
						<span class="va-badge">${escapeHtml(languageName(e.lang))} <code>${escapeHtml(e.lang)}</code></span>
						<span class="va-count">${e.strings} string${e.strings === 1 ? '' : 's'}</span>
					</div>
					<div class="va-item-mid">
						<strong>${escapeHtml(e.name)}</strong>
						${e.contact ? `<span class="va-contact">${escapeHtml(e.contact)}</span>` : ''}
					</div>
					<div class="va-item-bot">
						<code>#${escapeHtml(e.id)}</code>
						<span>${escapeHtml(dateStr)}</span>
					</div>
				</button>`;
			list.append(li);
		}
	}

	async function inspectSubmission(id: string): Promise<void> {
		selectedId = id;
		renderList();
		const detail = $('va-detail');
		detail.innerHTML = '<div class="va-detail-empty">Loading submission details…</div>';

		try {
			const res = await fetch(`${API}?id=${encodeURIComponent(id)}`, { credentials: 'same-origin' });
			if (res.status === 401) {
				setUnlocked(false);
				return;
			}
			if (!res.ok) {
				const err = (await res.json().catch(() => ({}))) as { error?: string };
				detail.innerHTML = `<div class="va-detail-empty">${escapeHtml(err.error || 'Could not load submission.')}</div>`;
				return;
			}
			const sub = (await res.json()) as FullSubmission;
			currentDetail = sub;
			const srcMap = await loadSourceMap(sub.lang);
			const rtl = RTL_LANGUAGES.has(sub.lang) ? ' dir="rtl"' : '';

			const rowsHtml = sub.suggestions
				.map((s) => {
					const src = srcMap.get(s.index);
					const formsHtml = s.texts
						.map((t, i) => {
							const base = s.base[i] ?? '';
							const label = s.texts.length > 1 ? `Form ${i + 1}` : 'Translation';
							return `
								<div class="va-diff-row">
									<span class="va-diff-label">${label}</span>
									${base ? `<div class="va-base" dir="auto"${rtl}><span>Base:</span> ${escapeHtml(base)}</div>` : ''}
									<div class="va-new" dir="auto"${rtl}>${escapeHtml(t) || '<em>(empty)</em>'}</div>
								</div>`;
						})
						.join('');
					return `
						<li class="va-sug">
							<div class="va-sug-head">
								<code>#${s.index}</code>
								${src ? `<code class="va-ctx">${escapeHtml(src.context)}</code>` : ''}
							</div>
							${src ? `<div class="va-src" dir="auto">${escapeHtml(src.source)}</div>` : ''}
							${formsHtml}
						</li>`;
				})
				.join('');

			detail.innerHTML = `
				<div class="va-detail-head">
					<div>
						<h2>${escapeHtml(languageName(sub.lang))} <code>${escapeHtml(sub.lang)}</code></h2>
						<p class="va-muted">
							By <strong>${escapeHtml(sub.name)}</strong>
							${sub.contact ? `(${escapeHtml(sub.contact)})` : ''} ·
							<code>#${escapeHtml(sub.id)}</code> ·
							${escapeHtml(new Date(sub.received).toLocaleString())}
						</p>
					</div>
					<div class="va-detail-actions">
						<button type="button" id="va-copy-json" class="button secondary">Copy JSON</button>
						<button type="button" id="va-accept-btn" class="button">Accept</button>
						<button type="button" id="va-reject-btn" class="button va-danger">Reject</button>
					</div>
				</div>
				<ol class="va-sug-list">${rowsHtml}</ol>`;
		} catch {
			detail.innerHTML = '<div class="va-detail-empty">Failed to load submission details.</div>';
		}
	}

	function downloadJson(filename: string, data: unknown): void {
		const blob = new Blob([JSON.stringify(data, null, 2) + '\n'], { type: 'application/json' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = filename;
		document.body.append(a);
		a.click();
		a.remove();
		URL.revokeObjectURL(url);
	}

	async function fetchQueue(preserveBanner = false): Promise<boolean> {
		if (!preserveBanner) showBanner('');
		try {
			const res = await fetch(API, { credentials: 'same-origin' });
			if (res.status === 401) {
				setUnlocked(false);
				return false;
			}
			const data = (await res.json().catch(() => ({}))) as {
				entries?: QueueSummaryItem[];
				error?: string;
			};
			if (!res.ok) {
				setUnlocked(true);
				showBanner(data.error || 'Failed to read queue.');
				return true;
			}
			setUnlocked(true);
			entries = data.entries ?? [];
			updateLangFilterOptions();
			renderList();
			if (!selectedId || !entries.some((e) => e.id === selectedId)) {
				selectedId = '';
				currentDetail = null;
				$('va-detail').innerHTML =
					'<div class="va-detail-empty">Select a submission to inspect its suggested strings.</div>';
			}
			return true;
		} catch {
			showBanner('Network error while contacting the queue endpoint.');
			return false;
		}
	}

	// ------------------------------------------------------------------ events
	$('va-toggle-pw').addEventListener('click', () => {
		const input = $('va-secret') as HTMLInputElement;
		const btn = $('va-toggle-pw');
		const show = input.type === 'password';
		input.type = show ? 'text' : 'password';
		btn.textContent = show ? 'Hide' : 'Show';
	});

	let lockTimer: number | null = null;

	function setLoginError(msg: string): void {
		const errEl = $('va-login-err');
		const wrap = $('va-pw-wrap');
		errEl.textContent = msg;
		wrap.classList.toggle('is-error', Boolean(msg));
		$('va-secret').setAttribute('aria-invalid', msg ? 'true' : 'false');
	}

	function startLockCountdown(seconds: number): void {
		if (lockTimer !== null) clearInterval(lockTimer);
		const btn = $('va-login-btn') as HTMLButtonElement;
		const input = $('va-secret') as HTMLInputElement;
		let left = Math.max(1, Math.floor(seconds));
		const render = () => {
			const mins = Math.floor(left / 60);
			const secs = String(left % 60).padStart(2, '0');
			setLoginError(`Locked for ${mins}:${secs} after too many failed tries.`);
			btn.disabled = true;
			input.disabled = true;
		};
		render();
		lockTimer = window.setInterval(() => {
			left -= 1;
			if (left <= 0) {
				if (lockTimer !== null) clearInterval(lockTimer);
				lockTimer = null;
				btn.disabled = false;
				input.disabled = false;
				setLoginError('');
				return;
			}
			render();
		}, 1000);
	}

	async function getDeviceFingerprint(): Promise<string> {
		let canvasSig = '';
		try {
			const canvas = document.createElement('canvas');
			canvas.width = 200;
			canvas.height = 40;
			const ctx = canvas.getContext('2d');
			if (ctx) {
				ctx.textBaseline = 'top';
				ctx.font = '14px sans-serif';
				ctx.fillStyle = '#92d600';
				ctx.fillText('pollymc-fp-v1', 2, 2);
				canvasSig = canvas.toDataURL();
			}
		} catch {
			// canvas blocked
		}
		const raw = [
			navigator.userAgent,
			navigator.language,
			(navigator.languages || []).join(','),
			navigator.platform || '',
			String(navigator.hardwareConcurrency || ''),
			String((navigator as unknown as { deviceMemory?: number }).deviceMemory || ''),
			`${screen.width}x${screen.height}x${screen.colorDepth}`,
			Intl.DateTimeFormat().resolvedOptions().timeZone || '',
			canvasSig,
		].join('|');
		const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(raw));
		return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
	}

	$('va-secret').addEventListener('input', () => {
		if (lockTimer === null) setLoginError('');
	});

	$('va-login-form').addEventListener('submit', async (e) => {
		e.preventDefault();
		if (lockTimer !== null) return;
		const btn = $('va-login-btn') as HTMLButtonElement;
		const secretInput = $('va-secret') as HTMLInputElement;
		const val = secretInput.value.trim();
		if (!val) {
			setLoginError('Please fill the field.');
			secretInput.focus();
			return;
		}
		setLoginError('');
		btn.disabled = true;
		btn.textContent = 'Verifying…';
		try {
			const fingerprint = await getDeviceFingerprint();
			const res = await fetch(API, {
				method: 'POST',
				credentials: 'same-origin',
				headers: {
					'Content-Type': 'application/json',
					'X-Device-Fingerprint': fingerprint,
				},
				body: JSON.stringify({ action: 'login', secret: secretInput.value, fingerprint }),
			});
			const data = (await res.json().catch(() => ({}))) as {
				error?: string;
				locked?: boolean;
				retryAfter?: number;
			};
			if (res.status === 429 || data.locked) {
				startLockCountdown(data.retryAfter ?? 1800);
				return;
			}
			if (!res.ok) {
				setLoginError(data.error || 'Wrong pass.');
				secretInput.focus();
				return;
			}
			secretInput.value = '';
			setLoginError('');
			await fetchQueue();
		} catch {
			setLoginError('Network error while signing in.');
		} finally {
			if (lockTimer === null) btn.disabled = false;
			btn.textContent = 'Unlock';
		}
	});

	$('va-logout').addEventListener('click', async () => {
		await fetch(API, {
			method: 'POST',
			credentials: 'same-origin',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ action: 'logout' }),
		}).catch(() => {});
		entries = [];
		selectedId = '';
		currentDetail = null;
		setUnlocked(false);
	});

	$('va-refresh').addEventListener('click', () => fetchQueue());
	$('va-search').addEventListener('input', renderList);

	$('va-list').addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.va-item-btn');
		if (btn?.dataset.id) inspectSubmission(btn.dataset.id);
	});

	$('va-detail').addEventListener('click', async (e) => {
		const target = e.target as HTMLElement;
		if (!currentDetail) return;

		if (target.id === 'va-copy-json') {
			await navigator.clipboard.writeText(JSON.stringify(currentDetail, null, 2));
			showBanner(`Copied submission #${currentDetail.id} JSON to clipboard.`, true);
			return;
		}

		if (target.id === 'va-accept-btn') {
			const btn = target as HTMLButtonElement;
			btn.disabled = true;
			btn.textContent = 'Accepting…';
			try {
				const res = await fetch(API, {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id: currentDetail.id }),
				});
				if (res.status === 401) {
					setUnlocked(false);
					return;
				}
				const payload = await res.json().catch(() => ({}));
				if (!res.ok) {
					showBanner((payload as { error?: string }).error || 'Failed to accept submission.');
					btn.disabled = false;
					btn.textContent = 'Accept';
					return;
				}
				const pr = (payload as { _pr?: { branch: string; url: string } })._pr;
				if (pr) {
					showBanner(`Accepted #${currentDetail.id}: the PR is being opened automatically (${pr.branch}).`, true);
				} else {
					downloadJson(`${currentDetail.lang}-${currentDetail.id}.json`, payload);
					showBanner(`Accepted #${currentDetail.id} and downloaded JSON.`, true);
				}
				selectedId = '';
				currentDetail = null;
				await fetchQueue(true);
			} catch {
				showBanner('Network error while accepting submission.');
				btn.disabled = false;
				btn.textContent = 'Accept';
			}
			return;
		}

		if (target.id === 'va-reject-btn') {
			const btn = target as HTMLButtonElement;
			if (btn.dataset.confirm !== 'true') {
				btn.dataset.confirm = 'true';
				btn.textContent = 'Confirm reject?';
				setTimeout(() => {
					if (btn.isConnected && btn.dataset.confirm === 'true') {
						btn.dataset.confirm = '';
						btn.textContent = 'Reject';
					}
				}, 4000);
				return;
			}
			btn.disabled = true;
			btn.textContent = 'Rejecting…';
			try {
				const res = await fetch(API, {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id: currentDetail.id, reject: true }),
				});
				if (res.status === 401) {
					setUnlocked(false);
					return;
				}
				const payload = (await res.json().catch(() => ({}))) as { error?: string };
				if (!res.ok) {
					showBanner(payload.error || 'Failed to reject submission.');
					btn.disabled = false;
					btn.textContent = 'Reject';
					return;
				}
				showBanner(`Rejected and removed #${currentDetail.id} from queue.`, true);
				selectedId = '';
				currentDetail = null;
				await fetchQueue(true);
			} catch {
				showBanner('Network error while rejecting submission.');
				btn.disabled = false;
				btn.textContent = 'Reject';
			}
		}
	});

	langFilterCtrl = initCustomSelect(
		$('va-lang-filter'),
		[{ value: 'all', label: 'All languages' }],
		langFilter,
		(val) => {
			langFilter = val;
			renderList();
		}
	);

	initCustomSelect(
		$('va-sort'),
		[
			{ value: 'fifo', label: 'Oldest first (FIFO)' },
			{ value: 'newest', label: 'Newest first' },
			{ value: 'strings', label: 'Most strings' },
		],
		sortMode,
		(val) => {
			sortMode = val;
			renderList();
		}
	);

	fetchQueue();
</script>

<style is:global>
	.va-gate {
		max-width: 28rem;
		margin: 3rem auto;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75em;
	}
	.va-lock-badge {
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		background: var(--accent);
		border: 1px solid var(--accent-light);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--primary);
	}
	.va-lock-badge svg {
		width: 1.4rem;
		height: 1.4rem;
	}
	.va-muted {
		color: var(--muted);
		margin: 0.2em 0;
	}
	.va-login-form {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.75em;
		margin-top: 0.5em;
	}
	.va-pw-wrap {
		display: flex;
		align-items: center;
		background: var(--accent);
		border: 1px solid var(--accent-light);
		border-radius: 8px;
		overflow: hidden;
	}
	.va-pw-wrap input {
		flex: 1;
		min-width: 0;
		padding: 0.65em 0.9em;
		font: inherit;
		color: var(--primary-text);
