---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../lib/site';

const description =
	'Contribute translations for the PollyMC-Continued launcher: edit only the strings that still need work, no GitHub account required.';
---

<Layout
	title="Translation editor"
	description={description}
	canonical={`${site.url}/translation/editor/`}
	active="translation"
	noindex
>
	<main id="main" class="container">
		<div class="content" id="editor-root">
			<div class="ed-head">
				<div class="ed-title-wrap">
					<h1 class="sec-h">Translation editor</h1>
					<span id="ed-lang-label" class="visually-hidden">Language</span>
					<div id="ed-lang-select" class="ed-lang-select" data-label-id="ed-lang-label"></div>
				</div>
				<a class="button secondary" href="/translation/">Back to languages</a>
			</div>
			<p id="ed-status" class="ed-status" role="status">Loading…</p>

			<div id="ed-bar" class="ed-bar hidden">
				<div class="ed-progress">
					<span id="ed-progress-fill"></span>
				</div>
				<div class="ed-stats">
					<span id="ed-stats-text"></span>
				</div>
				<div class="ed-filter">
					<label>
						<span class="visually-hidden">Search strings</span>
						<input id="ed-search" type="search" placeholder="Search source or context…" autocomplete="off" />
					</label>
					<span id="ed-mode-label" class="visually-hidden">Filter strings</span>
					<div id="ed-mode" class="ed-mode-select" data-label-id="ed-mode-label"></div>
				</div>
			</div>

			<div class="ed-pager hidden" data-pager>
				<button type="button" class="button secondary" data-page-nav="prev">Previous</button>
				<span class="ed-pager-label" data-pager-label></span>
				<button type="button" class="button secondary" data-page-nav="next">Next</button>
			</div>

			<ol id="ed-strings" class="ed-strings"></ol>

			<div class="ed-pager hidden" data-pager>
				<button type="button" class="button secondary" data-page-nav="prev">Previous</button>
				<span class="ed-pager-label" data-pager-label></span>
				<button type="button" class="button secondary" data-page-nav="next">Next</button>
			</div>

			<div id="ed-submit" class="ed-submit hidden">
				<h2>Your details</h2>
				<p class="ed-note">
					Your name is required and is credited when your contribution is merged. The contact address is
					optional and kept private: a reviewer may use it to ask about your translation. Neither is
					published anywhere.
				</p>
				<p id="ed-batch-note" class="ed-batch-note hidden"></p>
				<form id="ed-form" class="ed-form">
					<label class="ed-field">
						<span>Name (required)</span>
						<input id="ed-name" type="text" required minlength="2" maxlength="60" autocomplete="name" />
					</label>
					<label class="ed-field">
						<span>Contact (optional, private)</span>
						<input id="ed-contact" type="text" maxlength="80" autocomplete="email" placeholder="email, Discord, …" />
					</label>
					<label class="ed-consent">
						<input id="ed-consent" type="checkbox" required />
						<span>
							My contributions are licensed under GPL-3.0, like the launcher itself, and will be reviewed
							before they are merged.
						</span>
					</label>
					<button class="button is-big" type="submit" id="ed-send">Submit for review</button>
				</form>
				<p id="ed-result" class="ed-result" role="status"></p>
			</div>
		</div>
	</main>
</Layout>

<script>
	import { languageName, RTL_LANGUAGES } from '../../lib/languages';
	import { initCustomSelect, type CustomSelectController } from '../../scripts/custom-select';

	// ------------------------------------------------------------------ types
	interface Message {
		index: number; // position within the file, used as the stable id
		context: string;
		source: string;
		comment: string;
		obsolete: boolean; // vanished or obsolete entries are not shown
		unfinished: boolean;
		numerus: boolean;
		// one entry per plural form; singular strings have exactly one
		texts: string[];
		edited: string[] | null;
	}

	const MAX_BATCH = 60;
	// Only this many strings are in the DOM at once. Rendering every string of a
	// large language (3,000+ cards, each with auto-sizing textareas) froze and
	// crashed the tab.
	const PAGE_SIZE = 25;

	// --------------------------------------------------------------- helpers
	const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;

	function escapeHtml(text: string): string {
		return text
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#39;');
	}

	// Placeholder tokens, mirrored from scripts/validate.py in the translations repo:
	// %n and %1..%9 (%L1 counts as %1), entities like &amp;, and HTML tag names.
	const PERCENT_RE = /%(L\d+|\d+|n)/g;
	const ENTITY_RE = /&[a-zA-Z]+;/g;
	const TAG_RE = /<\/?[a-zA-Z][a-zA-Z0-9]*[^>]*>/g;
	const TAG_NAME_RE = /<\/?\s*([a-zA-Z][a-zA-Z0-9]*)/;

	function placeholders(text: string): string[] {
		const tokens: string[] = [];
		for (const m of text.matchAll(PERCENT_RE)) tokens.push('%' + m[1].replace(/^L/, ''));
		for (const m of text.matchAll(ENTITY_RE)) tokens.push(m[0]);
		for (const m of text.matchAll(TAG_RE)) {
			const name = TAG_NAME_RE.exec(m[0]);
			if (name) tokens.push(`<${name[1]}>`);
		}
		return tokens;
	}

	function lint(source: string, target: string): string | null {
		if (!target.trim()) return null; // empty is legal (still unfinished)
		const want = placeholders(source);
		const got = placeholders(target);
		const sorted = (xs: string[]) => [...xs].sort().join(',');
		if (sorted(want) !== sorted(got)) {
			return `Placeholders differ: the source has ${want.join(' ') || 'none'}, your text has ${got.join(' ') || 'none'}.`;
		}
		return null;
	}

	// ----------------------------------------------------------- .ts parsing
	function parseTs(xml: string): Message[] {
		const doc = new DOMParser().parseFromString(xml, 'application/xml');
		if (doc.querySelector('parsererror')) throw new Error('The translation file is not valid XML.');
		const out: Message[] = [];
		doc.querySelectorAll('context').forEach((context) => {
			const ctxName = context.querySelector('name')?.textContent ?? '';
			context.querySelectorAll(':scope > message').forEach((message) => {
				const tr = message.querySelector(':scope > translation');
				if (!tr) return;
				const state = tr.getAttribute('type') ?? '';
				const obsolete = state === 'vanished' || state === 'obsolete';
				const numerus = message.getAttribute('numerus') === 'yes';
				const forms = [...tr.querySelectorAll(':scope > numerusform')];
				let texts: string[];
				if (numerus && forms.length > 0) {
					texts = forms.map((f) => f.textContent ?? '');
				} else {
					texts = [tr.textContent ?? ''];
				}
				out.push({
					index: out.length,
					context: ctxName,
					source: message.querySelector(':scope > source')?.textContent ?? '',
					comment: message.querySelector(':scope > comment')?.textContent ?? '',
					obsolete,
					unfinished: state === 'unfinished' || state === 'fuzzy',
					numerus,
					texts,
					edited: null,
				});
			});
		});
		return out;
	}

	interface Suggestion {
		index: number;
		texts: string[];
	}

	// ------------------------------------------------------------ UI wiring
	let lang = '';
	let messages: Message[] = [];
	let filterMode = 'unfinished';
	let page = 0;
	let langSelectCtrl: CustomSelectController | null = null;
	const draftKey = () => `pollymc:translation-draft:${lang}`;

	async function initLanguageSwitcher(): Promise<void> {
		const root = $('ed-lang-select');
		try {
			const res = await fetch('/translation/index_v2.json');
			if (!res.ok) return;
			const data = (await res.json()) as { languages?: Record<string, { untranslated: number }> };
			const codes = Object.keys(data.languages ?? {}).sort((a, b) =>
				languageName(a).localeCompare(languageName(b))
			);
			const opts = codes.map((c) => ({ value: c, label: `${languageName(c)} (${c})` }));
			const initial = codes.includes(lang) ? lang : '';
			if (!initial) opts.unshift({ value: '', label: 'Select a language…' });
			langSelectCtrl = initCustomSelect(root, opts, initial, (nextLang) => {
				if (!nextLang || nextLang === lang) return;
				const url = new URL(location.href);
				url.searchParams.set('lang', nextLang);
				history.replaceState(null, '', url.toString());
				loadLanguage(nextLang);
			});
		} catch {
			// non-fatal: page still works with ?lang=
		}
	}

	async function loadLanguage(explicitCode?: string): Promise<void> {
		const code = explicitCode ?? (new URLSearchParams(location.search).get('lang') ?? '');
		if (!/^[\w@.-]{1,30}$/.test(code)) {
			$('ed-status').classList.remove('hidden');
			$('ed-bar').classList.add('hidden');
			$('ed-submit').classList.add('hidden');
			$('ed-strings').textContent = '';
			$('ed-status').textContent =
				'No language selected. Pick a language from the dropdown above or go back to the language list.';
			return;
		}
		lang = code;
		page = 0;
		langSelectCtrl?.setValue(code, true);
		$('ed-status').classList.remove('hidden');
		$('ed-status').textContent = `Loading ${languageName(code)}…`;
		$('ed-bar').classList.add('hidden');
		$('ed-submit').classList.add('hidden');
		$('ed-strings').textContent = '';
		$('ed-result').textContent = '';
		$('ed-result').classList.remove('ed-ok');

		try {
			const res = await fetch(`/translation/sources/${encodeURIComponent(code)}.ts`);
			if (!res.ok) throw new Error(`file -> ${res.status}`);
			messages = parseTs(await res.text());
			restoreDraft();
			showMessages();
			$('ed-status').classList.add('hidden');
			$('ed-bar').classList.remove('hidden');
			$('ed-submit').classList.remove('hidden');
		} catch {
			$('ed-status').textContent =
				'That language could not be loaded. Go back to the list of languages and try again.';
		}
	}

	function visible(): Message[] {
		const q = ($('ed-search') as HTMLInputElement).value.trim().toLowerCase();
		return messages.filter((m) => {
			if (m.obsolete) return false;
			if (filterMode === 'unfinished' && !m.unfinished) return false;
			if (filterMode === 'changed' && !m.edited) return false;
			if (filterMode === 'warnings') {
				if (!m.edited) return false;
				if (!m.edited.some((t) => lint(m.source, t))) return false;
			}
			if (q && !`${m.source} ${m.context} ${m.comment}`.toLowerCase().includes(q)) return false;
			return true;
		});
	}

	function card(m: Message): HTMLLIElement {
		const li = document.createElement('li');
		li.className = 'ed-string';
		if (m.edited) li.classList.add('is-edited');
		const rtl = RTL_LANGUAGES.has(lang) ? ' dir="rtl"' : '';
		const tokens = [...new Set(placeholders(m.source))];
		const tokenHtml =
			tokens.length > 0
				? `<div class="ed-tokens">${tokens
						.map(
							(tok) =>
								`<button type="button" class="ed-token" data-token="${escapeHtml(tok)}" data-index="${m.index}" title="Insert placeholder">${escapeHtml(tok)}</button>`
						)
						.join('')}</div>`
				: '';

		const forms = m.texts
			.map((t, i) => {
				const label = m.numerus ? `Plural form ${i + 1}` : 'Translation';
				const currentVal = m.edited ? m.edited[i] : t;
				const err = m.edited ? lint(m.source, currentVal) : null;
				return `
					<label class="ed-form-row">
						<span class="ed-form-label">${label}</span>
						<textarea
							class="ed-input${m.numerus ? '' : ' ed-single'}"
							rows="1"
							dir="auto"${rtl}
							data-index="${m.index}" data-form="${i}"
							aria-invalid="${err ? 'true' : 'false'}"
							spellcheck="false">${escapeHtml(currentVal)}</textarea>
					</label>`;
			})
			.join('');

		const activeWarnings = m.edited
			? (m.edited.map((t) => lint(m.source, t)).filter(Boolean) as string[]).join(' ')
			: '';

		li.innerHTML = `
			<div class="ed-src-head">
				<code class="ed-context">${escapeHtml(m.context)}</code>
				${m.edited ? `<button type="button" class="ed-reset" data-reset="${m.index}">Reset</button>` : ''}
			</div>
			<div class="ed-source" dir="auto">${escapeHtml(m.source) || '<em>(empty source)</em>'}</div>
			${m.comment ? `<div class="ed-comment" dir="auto">${escapeHtml(m.comment)}</div>` : ''}
			${tokenHtml}
			<div class="ed-forms">${forms}</div>
			<div class="ed-warn" data-warn="${m.index}">${escapeHtml(activeWarnings)}</div>`;
		return li;
	}

	function showMessages(): void {
		const list = $('ed-strings');
		list.textContent = '';
		const rows = visible();
		const pages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
		if (page >= pages) page = pages - 1;
		if (page < 0) page = 0;

		if (rows.length === 0) {
			list.innerHTML = `<li class="ed-empty">Nothing matches the current filter.</li>`;
		} else {
			const frag = document.createDocumentFragment();
			const from = page * PAGE_SIZE;
			for (const m of rows.slice(from, from + PAGE_SIZE)) frag.append(card(m));
			list.append(frag);
			autoGrowAll(list.querySelectorAll<HTMLTextAreaElement>('.ed-input'));
		}
		updatePagers(rows.length, pages);
		updateStats();
	}

	function updatePagers(total: number, pages: number): void {
		const from = total === 0 ? 0 : page * PAGE_SIZE + 1;
		const to = Math.min(total, (page + 1) * PAGE_SIZE);
		document.querySelectorAll<HTMLElement>('[data-pager]').forEach((el) => {
			el.classList.toggle('hidden', pages <= 1);
			const label = el.querySelector<HTMLElement>('[data-pager-label]');
			if (label) label.textContent = `${from}–${to} of ${total} · page ${page + 1}/${pages}`;
			const prev = el.querySelector<HTMLButtonElement>('[data-page-nav="prev"]');
			const next = el.querySelector<HTMLButtonElement>('[data-page-nav="next"]');
			if (prev) prev.disabled = page === 0;
			if (next) next.disabled = page >= pages - 1;
		});
	}

	function goToPage(delta: number): void {
		page += delta;
		showMessages();
		$('ed-bar').scrollIntoView({ block: 'start' });
	}

	function resetToFirstPage(): void {
		page = 0;
		showMessages();
	}

	function updateStats(): void {
		const unfinished = messages.filter((m) => m.unfinished && !m.obsolete).length;
		const changed = messages.filter((m) => m.edited).length;
		$('ed-stats-text').textContent =
			`${changed} of ${unfinished} unfinished strings touched · ${messages.length} total`;
		const pct = unfinished > 0 ? Math.round((changed / unfinished) * 100) : 100;
		($('ed-progress-fill') as HTMLElement).style.width = `${pct}%`;

		const batchNote = $('ed-batch-note');
		if (changed > MAX_BATCH) {
			batchNote.classList.remove('hidden');
			batchNote.textContent = `You have ${changed} modified strings. Submissions are sent in batches of ${MAX_BATCH}; submitting now will send the first ${MAX_BATCH} and keep the remaining ${changed - MAX_BATCH} in your local draft.`;
		} else {
			batchNote.classList.add('hidden');
			batchNote.textContent = '';
		}
	}

	function syncMessageCard(m: Message, ta?: HTMLTextAreaElement): void {
		const cardEl = ta?.closest('.ed-string');
		if (cardEl) cardEl.classList.toggle('is-edited', Boolean(m.edited));
		const warn = document.querySelector(`.ed-warn[data-warn="${m.index}"]`) as HTMLElement | null;
		if (warn) {
			const problems = m.edited
				? (m.edited.map((t) => lint(m.source, t)).filter(Boolean) as string[])
				: [];
			warn.textContent = problems.join(' ');
		}
		if (ta && m.edited) {
			const formIdx = Number(ta.dataset.form);
			ta.setAttribute('aria-invalid', lint(m.source, m.edited[formIdx] ?? '') ? 'true' : 'false');
		} else if (ta) {
			ta.setAttribute('aria-invalid', 'false');
		}
	}

	// Edits update the message in place, lint, and persist a draft.
	function onInput(e: Event): void {
		const ta = e.target as HTMLTextAreaElement;
		if (!ta.classList.contains('ed-input')) return;
		const m = messages[Number(ta.dataset.index)];
		if (!m) return;
		if (!m.edited) m.edited = [...m.texts];
		m.edited[Number(ta.dataset.form)] = ta.value;

		// Revert to clean state if all forms match the original text.
		if (m.edited.every((t, i) => t === m.texts[i])) {
			m.edited = null;
		}

		autoGrow(ta);
		syncMessageCard(m, ta);
		saveDraft();
		updateStats();
	}

	function onStringsClick(e: Event): void {
		const target = e.target as HTMLElement;
		const resetBtn = target.closest<HTMLButtonElement>('.ed-reset');
		if (resetBtn) {
			const m = messages[Number(resetBtn.dataset.reset)];
			if (!m) return;
			m.edited = null;
			saveDraft();
			showMessages();
			return;
		}
		const tokBtn = target.closest<HTMLButtonElement>('.ed-token');
		if (tokBtn) {
			const idx = Number(tokBtn.dataset.index);
			const tok = tokBtn.dataset.token ?? '';
			const cardEl = tokBtn.closest('.ed-string');
			const ta = cardEl?.querySelector<HTMLTextAreaElement>(`.ed-input[data-index="${idx}"]`);
			if (!ta) return;
			const start = ta.selectionStart ?? ta.value.length;
			const end = ta.selectionEnd ?? ta.value.length;
			ta.value = ta.value.slice(0, start) + tok + ta.value.slice(end);
			ta.focus();
			ta.setSelectionRange(start + tok.length, start + tok.length);
			ta.dispatchEvent(new Event('input', { bubbles: true }));
		}
	}

	function autoGrow(ta: HTMLTextAreaElement): void {
		ta.style.height = 'auto';
		ta.style.height = `${ta.scrollHeight + 2}px`;
	}

	// Measure every textarea first, then resize them all: interleaving reads and
	// writes forces a full layout per textarea.
	function autoGrowAll(tas: Iterable<HTMLTextAreaElement>): void {
		const all = [...tas];
		for (const ta of all) ta.style.height = 'auto';
		const heights = all.map((ta) => ta.scrollHeight + 2);
		all.forEach((ta, i) => {
			ta.style.height = `${heights[i]}px`;
		});
	}

	let draftTimer: number | undefined;
	function saveDraft(): void {
		window.clearTimeout(draftTimer);
		draftTimer = window.setTimeout(saveDraftNow, 400);
	}

	function saveDraftNow(): void {
		window.clearTimeout(draftTimer);
		if (!lang) return;
		const edited: Suggestion[] = messages
			.filter((m) => m.edited)
			.map((m) => ({ index: m.index, texts: m.edited as string[] }));
		try {
			if (edited.length === 0) localStorage.removeItem(draftKey());
			else localStorage.setItem(draftKey(), JSON.stringify({ when: Date.now(), edited }));
		} catch {
			// storage full or unavailable: keep working without the draft
		}
	}

	function restoreDraft(): void {
		try {
			const raw = localStorage.getItem(draftKey());
			if (!raw) return;
			const { edited } = JSON.parse(raw) as { edited: Suggestion[] };
			for (const s of edited) {
				const m = messages[s.index];
				if (m && !m.obsolete && Array.isArray(s.texts) && s.texts.length === m.texts.length) {
					if (s.texts.some((t, i) => t !== m.texts[i])) {
						m.edited = [...s.texts];
					}
				}
			}
		} catch {
			// a malformed draft is ignored, not fatal
		}
	}

	// ------------------------------------------------------------------ PoW
	// Runs in a Blob Web Worker using fast synchronous SHA-256 so 20-bit PoW
	// finishes in ~0.3-1s without freezing the UI thread.
	const WORKER_SRC = `
		const K = new Uint32Array([
			0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
			0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
			0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
			0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
			0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
			0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
			0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
			0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
		]);
		const W = new Uint32Array(64);
		function sha256Bytes(bytes) {
			const len = bytes.length;
			const bitLen = len * 8;
			const paddedLen = ((len + 9 + 63) >> 6) << 6;
			const buf = new Uint8Array(paddedLen);
			buf.set(bytes);
			buf[len] = 0x80;
			const dv = new DataView(buf.buffer);
			dv.setUint32(paddedLen - 8, Math.floor(bitLen / 0x100000000), false);
			dv.setUint32(paddedLen - 4, bitLen >>> 0, false);
			let h0=0x6a09e667,h1=0xbb67ae85,h2=0x3c6ef372,h3=0xa54ff53a,h4=0x510e527f,h5=0x9b05688c,h6=0x1f83d9ab,h7=0x5be0cd19;
			for (let off = 0; off < paddedLen; off += 64) {
				for (let i = 0; i < 16; i++) W[i] = dv.getUint32(off + i * 4, false);
				for (let i = 16; i < 64; i++) {
					const w15 = W[i-15], w2 = W[i-2];
					const s0 = ((w15 >>> 7) | (w15 << 25)) ^ ((w15 >>> 18) | (w15 << 14)) ^ (w15 >>> 3);
					const s1 = ((w2 >>> 17) | (w2 << 15)) ^ ((w2 >>> 19) | (w2 << 13)) ^ (w2 >>> 10);
					W[i] = (W[i-16] + s0 + W[i-7] + s1) >>> 0;
				}
				let a=h0,b=h1,c=h2,d=h3,e=h4,f=h5,g=h6,h=h7;
				for (let i = 0; i < 64; i++) {
					const S1 = ((e >>> 6) | (e << 26)) ^ ((e >>> 11) | (e << 21)) ^ ((e >>> 25) | (e << 7));
					const ch = (e & f) ^ ((~e) & g);
					const t1 = (h + S1 + ch + K[i] + W[i]) >>> 0;
					const S0 = ((a >>> 2) | (a << 30)) ^ ((a >>> 13) | (a << 19)) ^ ((a >>> 22) | (a << 10));
					const maj = (a & b) ^ (a & c) ^ (b & c);
					const t2 = (S0 + maj) >>> 0;
					h=g; g=f; f=e; e=(d+t1)>>>0; d=c; c=b; b=a; a=(t1+t2)>>>0;
				}
				h0=(h0+a)>>>0; h1=(h1+b)>>>0; h2=(h2+c)>>>0; h3=(h3+d)>>>0;
				h4=(h4+e)>>>0; h5=(h5+f)>>>0; h6=(h6+g)>>>0; h7=(h7+h)>>>0;
			}
			return [h0,h1,h2,h3,h4,h5,h6,h7];
		}
		self.onmessage = (ev) => {
			const { payload, bits } = ev.data;
			const enc = new TextEncoder();
			const pHashWords = sha256Bytes(enc.encode(payload));
			const digest = pHashWords.map(w => w.toString(16).padStart(8, '0')).join('');
			const ts = Math.floor(Date.now() / 1000);
			const prefix = ts + ':';
			const suffix = ':' + digest;
			for (let nonce = 0; ; nonce++) {
				const words = sha256Bytes(enc.encode(prefix + nonce + suffix));
				let z = 0;
				for (let i = 0; i < 8; i++) {
					if (words[i] === 0) { z += 32; continue; }
					z += Math.clz32(words[i]);
					break;
				}
				if (z >= bits) {
					self.postMessage({ powTime: String(ts), powNonce: String(nonce) });
					return;
				}
			}
		};
	`;

	function solvePow(payload: string, bits: number): Promise<{ powTime: string; powNonce: string }> {
		return new Promise((resolve, reject) => {
			const blob = new Blob([WORKER_SRC], { type: 'application/javascript' });
			const url = URL.createObjectURL(blob);
			const worker = new Worker(url);
			worker.onmessage = (e) => {
				worker.terminate();
				URL.revokeObjectURL(url);
				resolve(e.data);
			};
			worker.onerror = (err) => {
				worker.terminate();
				URL.revokeObjectURL(url);
				reject(err);
			};
			worker.postMessage({ payload, bits });
		});
	}

	// ------------------------------------------------------------- submission
	async function submit(e: SubmitEvent): Promise<void> {
		e.preventDefault();
		const result = $('ed-result');
		const send = $('ed-send') as HTMLButtonElement;
		const editedAll = messages.filter((m) => m.edited);
		if (editedAll.length === 0) {
			result.classList.remove('ed-ok');
			result.textContent = 'Nothing to submit: translate at least one string first.';
			return;
		}
		const batch = editedAll.slice(0, MAX_BATCH);
		const problems = batch.flatMap((m) =>
			m.edited!.map((t) => lint(m.source, t)).filter(Boolean) as string[]
		);
		if (problems.length > 0) {
			result.classList.remove('ed-ok');
			result.textContent = 'Some translations are missing placeholders. Fix the highlighted warnings first.';
			return;
		}

		const body = {
			lang,
			name: ($('ed-name') as HTMLInputElement).value.trim(),
			contact: ($('ed-contact') as HTMLInputElement).value.trim(),
			suggestions: batch.map((m) => ({ index: m.index, base: m.texts, texts: m.edited })),
		};

		send.disabled = true;
		send.textContent = 'Verifying & sending…';
		result.classList.remove('ed-ok');
		result.textContent = '';
		let succeeded = false;
		try {
			const pow = await solvePow(JSON.stringify(body.suggestions), 20);
			const res = await fetch('/api/translations', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ ...body, ...pow }),
			});
			const data = (await res.json().catch(() => ({}))) as { error?: string; queued?: number };
			if (res.ok) {
				succeeded = true;
				for (const m of batch) {
					m.texts = [...(m.edited as string[])];
					m.edited = null;
					m.unfinished = false;
				}
				saveDraft();
				result.classList.add('ed-ok');
				const remaining = editedAll.length - batch.length;
				result.textContent =
					remaining > 0
						? `Thank you! ${data.queued ?? batch.length} string(s) are queued for review. ${remaining} more modified string(s) remain in your draft — click Submit again to send the next batch.`
						: `Thank you! ${data.queued ?? batch.length} string(s) are queued for review. Once a maintainer approves them they become a pull request in the translations repository.`;
				showMessages();
			} else {
				result.textContent = data.error || 'The submission could not be sent. Please try again later.';
			}
		} catch {
			result.textContent = 'The submission could not be sent. Please try again later.';
		} finally {
			send.disabled = false;
			send.textContent = succeeded && editedAll.length <= batch.length ? 'Submitted' : 'Submit for review';
		}
	}

	// ------------------------------------------------------------------ boot
	initCustomSelect(
		$('ed-mode'),
		[
			{ value: 'unfinished', label: 'Unfinished strings' },
			{ value: 'changed', label: 'My changes only' },
			{ value: 'warnings', label: 'Placeholder warnings' },
			{ value: 'all', label: 'All active strings' },
		],
		filterMode,
		(val) => {
			filterMode = val;
			resetToFirstPage();
		}
	);

	let searchTimer: number | undefined;
	$('ed-strings').addEventListener('input', onInput);
	$('ed-strings').addEventListener('click', onStringsClick);
	$('ed-search').addEventListener('input', () => {
		window.clearTimeout(searchTimer);
		searchTimer = window.setTimeout(resetToFirstPage, 200);
	});
	document.querySelectorAll<HTMLButtonElement>('[data-page-nav]').forEach((btn) =>
		btn.addEventListener('click', () => goToPage(btn.dataset.pageNav === 'next' ? 1 : -1))
	);
	// Never lose a draft that is still waiting on the debounce timer.
	window.addEventListener('pagehide', saveDraftNow);
	document.addEventListener('visibilitychange', () => {
		if (document.visibilityState === 'hidden') saveDraftNow();
	});
	$('ed-form').addEventListener('submit', submit);
	initLanguageSwitcher();
	loadLanguage();
</script>

