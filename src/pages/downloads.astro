---
import Layout from '../layouts/Layout.astro';
import DownloadTabs from '../components/DownloadTabs.astro';
import { site } from '../lib/site';
import releases from '../data/releases.json';

const description = 'Download PollyMC-Continued for Windows, Linux and macOS.';
const total = releases.totalDownloads.toLocaleString();
---

<Layout
	title="Downloads"
	description={description}
	canonical={`${site.url}/downloads/`}
	active="downloads"
>
	<main id="main" class="container">
		<div class="content">
			<div class="downloads-head">
				<h1 class="sec-h">Downloads</h1>
				<p class="downloads-total" aria-live="polite">
					<span class="num">{total}</span>
					<span class="label">total downloads across all releases</span>
				</p>
			</div>

			<DownloadTabs />
		</div>
	</main>
</Layout>

<script>
	import '../scripts/tabs.ts';
</script>
