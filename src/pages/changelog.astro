---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
import changelogBg from '../assets/changelogbg.webp';

const description = 'Release history and changelog for PollyMC-Continued.';
---

<Layout
	title="Changelog"
	description={description}
	canonical={`${site.url}/changelog/`}
	background={changelogBg}
	active="changelog"
>
	<main id="main" class="container">
		<div class="content">
			<h1 class="sec-h">Changelog</h1>
			<p class="feature-subs">
				Release notes for PollyMC-Continued, straight from the repository.
			</p>
			<div class="changelog">
				<p class="feature-subs">Loading…</p>
			</div>
		</div>
	</main>
</Layout>

<script>
	import '../scripts/changelog.ts';
</script>
